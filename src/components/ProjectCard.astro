---
import type { Project } from '../data/projects';

interface Props { project: Project }
const { project } = Astro.props;
---

<article class:list={['project-card', `project-card--${project.accent}`]}>
  <div class="project-card__topline">
    <strong>{project.code}</strong><span>{project.status}</span><span class="status-dot" aria-hidden="true"></span>
  </div>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <ul class="tag-list" aria-label={`${project.title} topics`}>
    {project.tags.map((tag) => <li class="crt-chip">{tag}</li>)}
  </ul>
  <div class="button-row">
    {project.url && <a class="button" href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{project.slug === 'signalbox' ? 'Read project file' : 'Visit project'} {project.url.startsWith('http') && <span aria-hidden="true">↗</span>}</a>}
    {project.source && <a class="text-link" href={project.source} target="_blank" rel="noopener noreferrer">Source <span aria-hidden="true">↗</span></a>}
    {!project.url && !project.source && <a class="button" href={`/projects#${project.slug}`}>Read project file</a>}
  </div>
</article>
