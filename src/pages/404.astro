---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowPanel from '../components/WindowPanel.astro';
---

<BaseLayout
  title="404 / Page Not Found"
  description="The requested page could not be found on itscol.es."
  noindex
  canonicalPath={false}
>
  <div class="error-page">
    <header class="page-heading page-heading--error">
      <p class="eyebrow">error 404 · no carrier</p>
      <h1>Requested node not found</h1>
      <p>The page you asked for does not exist. The signal may have moved, expired, or never been there.</p>
    </header>

    <WindowPanel title="ROUTE_DIAGNOSTIC.LOG" class="error-panel" eyebrow="Connection terminated">
      <dl class="error-status">
        <div><dt>Signal</dt><dd>Lost</dd></div>
        <div><dt>Route</dt><dd>Unknown</dd></div>
        <div><dt>Status</dt><dd>404</dd></div>
        <div><dt>Operator</dt><dd>Wizard</dd></div>
      </dl>
      <p class="error-message">NO CARRIER. Nothing useful is hiding here.</p>
      <nav class="error-nav" aria-label="Page not found navigation">
        <a class="button" href="/">Return home</a>
        <a href="/projects">Projects</a>
        <a href="/experiments">Lab / Experiments</a>
        <a href="/about">About</a>
      </nav>
    </WindowPanel>
  </div>
</BaseLayout>
