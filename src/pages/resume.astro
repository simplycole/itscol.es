---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowPanel from '../components/WindowPanel.astro';

const experience = [
  {
    company: 'Nursing CE Central', dates: '02/2026 – Present', role: 'Senior Full Stack Web Developer',
    details: [
      'Develop and maintain custom WordPress-based learning, membership, certificate, dashboard, reporting, and integration systems for a continuing education platform.',
      'Build database-backed WordPress and PHP features across LearnDash, certificates, dashboards, state-specific workflows, and user account systems.',
      'Develop shortcodes, helper functions, API integrations, and reusable platform logic to improve reporting, membership, and certificate workflows.',
      'Debug and validate production workflows across local and staging environments, including user metadata, SQL records, and third-party reporting integrations.',
    ],
  },
  {
    company: 'demandDrive', dates: '08/2024 – 02/2026', role: 'Senior Software Engineer / Full Stack Developer',
    details: [
      'Architected, developed, and optimized full-stack software and internal platforms with distributed teams.',
      'Designed and maintained applications aligned with business, operational, and user-experience requirements.',
      'Translated ambiguous business needs into maintainable technical solutions.',
      'Improved reliability through production debugging, optimization, documentation, and development-process improvements.',
    ],
  },
  {
    company: 'JRP', dates: '03/2020 – 08/2024', role: 'Senior Software Engineer / Full Stack Developer',
    details: [
      'Led development, deployment, and maintenance of responsive websites, custom applications, and client-facing digital platforms.',
      'Developed and deployed more than 100 websites using WordPress, custom themes, plugins, PHP, JavaScript, HTML, CSS, and MySQL.',
      'Built reusable components, custom functionality, and CMS-driven solutions.',
      'Configured development environments, staging workflows, hosting, and production deployments.',
    ],
  },
  {
    company: 'OTR Wheel Engineering, Inc.', dates: '08/2014 – 03/2020', role: 'Senior Web Developer / Web Development Manager',
    details: [
      'Managed web development for public websites, internal applications, marketing assets, and e-commerce initiatives across multiple subsidiaries.',
      'Maintained Linux-based web and application infrastructure using NGINX, Apache, and MySQL.',
      'Designed and developed internal tools supporting inventory, pricing, customer service, and sales workflows.',
      "Led development and launch of the company's e-commerce platform, generating more than $600,000 in sales within its first six months.",
    ],
  },
  {
    company: 'Wolters Kluwer', dates: '07/2006 – 08/2014', role: 'Applications Developer II',
    details: [
      'Supported enterprise software releases, build automation, installer projects, and Agile SDLC processes for tax and accounting software platforms.',
      'Built and maintained automated desktop and web build processes using MSBuild, PowerShell, XAML, and Visual Build.',
      'Supported release candidates, installer workflows, source control, and customer-facing software delivery.',
    ],
  },
];

const technicalSkills = ['PHP', 'WordPress', 'Custom Themes & Plugins', 'JavaScript', 'TypeScript', 'React', 'REST APIs', 'API Integrations', 'SQL', 'MySQL', 'Git', 'Docker', 'Linux', 'NGINX', 'CI/CD', 'Debugging', 'Performance Optimization', 'HTML', 'CSS', 'Astro', 'Node.js'];
const professionalSkills = ['Problem-solving', 'Cross-functional collaboration', 'Stakeholder communication', 'Technical leadership', 'Requirements translation', 'Testing & validation'];
---

<BaseLayout title="Résumé" description="The professional experience and technical capabilities of Senior Full Stack Software Engineer Cole Pearson.">
  <header class="page-heading page-heading--resume">
    <p class="eyebrow">resume.txt · human-readable mode</p>
    <h1>Work, minus the fog</h1>
    <p>Cole Pearson · Senior Full Stack Software Engineer</p>
  </header>

  <div class="content-stack resume-document">
    <WindowPanel title="01 // PROFILE" class="resume-panel">
      <div class="resume-profile">
        <p>Senior Full Stack Software Engineer with 20+ years of experience building scalable web applications, custom platforms, API integrations, internal tools, and business-critical systems.</p>
        <p>Strong across application architecture, maintainable product development, production debugging, and performance optimization.</p>
      </div>
    </WindowPanel>

    <WindowPanel title="02 // EXPERIENCE" class="resume-panel resume-panel--experience">
      <ol class="experience-list">
        {experience.map((job) => (
          <li class="experience-item">
            <div class="experience-item__heading">
              <div><h3>{job.company}</h3><p>{job.role}</p></div>
              <p class="experience-item__dates">{job.dates}</p>
            </div>
            <ul>{job.details.map((detail) => <li>{detail}</li>)}</ul>
          </li>
        ))}
      </ol>
    </WindowPanel>

    <WindowPanel title="03 // TOOLCHAIN" class="resume-panel">
      <ul class="skill-list" aria-label="Technical skills">{technicalSkills.map((skill) => <li class="crt-chip">{skill}</li>)}</ul>
    </WindowPanel>

    <WindowPanel title="04 // PROFESSIONAL CAPABILITIES" class="resume-panel">
      <ul class="skill-list skill-list--professional" aria-label="Professional skills">{professionalSkills.map((skill) => <li class="crt-chip">{skill}</li>)}</ul>
    </WindowPanel>

    <WindowPanel title="05 // EDUCATION" class="resume-panel">
      <div class="education-item">
        <div><h3>Berry College</h3><p>Bachelor's Degree — Computer Science</p></div>
        <p class="experience-item__dates">01/2002 – 01/2006</p>
      </div>
      <div class="button-row resume-contact">
        <a class="button" href="https://linkedin.com/in/simplycole" target="_blank" rel="noopener noreferrer">Professional inquiries via LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="https://github.com/simplycole" target="_blank" rel="noopener noreferrer">Inspect GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </WindowPanel>
  </div>
</BaseLayout>
