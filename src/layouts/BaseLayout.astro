---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string | false;
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  noindex = false,
  canonicalPath,
  schema,
} = Astro.props;
const siteName = 'Cole Pearson — Senior Software Engineer | Full Stack & Platform Engineer';
const pageTitle = title ? `${title} — Cole Pearson` : siteName;
const site = Astro.site ?? new URL('https://itscol.es');
const canonical = canonicalPath === false ? undefined : new URL(canonicalPath ?? Astro.url.pathname, site);
const socialImage = new URL('/social-card.png', site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Cole Pearson',
  url: site.href,
  jobTitle: 'Senior Software Engineer | Full Stack / Platform Engineer',
  sameAs: ['https://github.com/simplycole', 'https://linkedin.com/in/simplycole'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#030403" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="itscol.es" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cole Pearson — Senior Software Engineer and Full Stack / Platform Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <div class="rack-strip" aria-label="Node diagnostics">
        <span><i></i>SIGNAL <b>PRESENT</b></span><span><i></i>LINK <b>56K</b></span><span><i></i>SYSTEM <b>NOMINAL</b></span><span class="rack-strip__warning"><i></i>COFFEE <b>CRITICAL</b></span><span class="rack-serial">CP-96 / 08.29</span>
      </div>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
